# Security (set a strong key for your environment)
API_KEY=your-api-key-here

# Voice pipeline
OBFUSCATION_STRENGTH=mild
STT_MODEL=small.en
EDGE_TTS_VOICE=en-US-GuyNeural

# LLM Orchestrator
OLLAMA_MODEL=llama3.2:latest
MAX_RESULTS=10
MAX_RETRIES=2

# Audio limits
# MAX_AUDIO_SIZE_MB=25
# MAX_AUDIO_DURATION_SECONDS=120.0

# Timeouts (seconds)
LLM_TIMEOUT_SECONDS=120.0
# TTS_TIMEOUT_SECONDS=15.0
# STT_TIMEOUT_SECONDS=60.0
# OBFUSCATION_TIMEOUT_SECONDS=30.0

# CORS & Logging
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# LOG_TRANSCRIPTS=false
